      "parameters": {
        "jsCode": "const BACKUP = {\n  cars: 'car reviews viral',\n  tech: 'tech viral',\n  music: 'music viral',\n  gaming: 'gaming viral',\n  fitness: 'workout motivation',\n  cooking: 'cooking viral',\n  travel: 'travel vlog',\n  comedy: 'comedy viral',\n  education: 'educational viral',\n  diy: 'DIY viral',\n  beauty: 'makeup viral',\n  fashion: 'fashion viral',\n  sports: 'sports viral',\n  news: 'news viral',\n  entertainment: 'celebrity viral',\n  science: 'science viral',\n  history: 'history viral',\n  art: 'art viral',\n  pets: 'pets viral',\n  nature: 'nature viral',\n  business: 'business viral',\n  motivation: 'motivation viral',\n  lifestyle: 'lifestyle viral',\n  other: 'viral trending',\n};\n\nconst items = $input.all();\nreturn items.map((item) => {\n  const j = item.json || {};\n  const clip_class = j.clip_class || 'other';\n  const query = BACKUP[clip_class] || BACKUP.other;\n  const maxResults = Math.min(Math.max(j.deficit || 1, 1), 10);\n  return { json: { clip_class, query, maxResults } };\n});"
