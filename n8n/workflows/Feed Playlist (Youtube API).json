{
  "name": "Feed Playlist (Youtube API)",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  t.clip_class,\n  t.target_count,\n  COALESCE(COUNT(c.clip_id), 0) AS queued_count,\n  (t.target_count - COALESCE(COUNT(c.clip_id), 0)) AS deficit\nFROM feed_inventory_targets t\nLEFT JOIN clips c\n  ON c.clip_class = t.clip_class\n AND c.status = 'queued'\nGROUP BY t.clip_class, t.target_count\nHAVING (t.target_count - COALESCE(COUNT(c.clip_id), 0)) > 0;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -384,
        64
      ],
      "id": "32a1cd0a-548c-4e96-be26-9a1d7909f442",
      "name": "Get Classes Needing Inventory (Postgres)"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Map each class to a YouTube search config.\n// Fill in channelId/query to match your sources.\nconst config = {\n  cars:          { query: 'car reviews podcast',           channelId: '' },\n  tech:          { query: 'tech news podcast',             channelId: '' },\n  music:         { query: 'music production tips',         channelId: '' },\n  gaming:        { query: 'gaming highlights',             channelId: '' },\n  fitness:       { query: 'workout motivation talk',       channelId: '' },\n  cooking:       { query: 'cooking show long form',        channelId: '' },\n  travel:        { query: 'travel vlog',                   channelId: '' },\n  comedy:        { query: 'standup comedy special',        channelId: '' },\n  education:     { query: 'educational lecture',           channelId: '' },\n  diy:           { query: 'DIY tutorial',                  channelId: '' },\n  beauty:        { query: 'makeup tutorial long',          channelId: '' },\n  fashion:       { query: 'fashion tips talk',             channelId: '' },\n  sports:        { query: 'sports analysis show',          channelId: '' },\n  news:          { query: 'news commentary',               channelId: '' },\n  entertainment: { query: 'celebrity interview',           channelId: '' },\n  science:       { query: 'science documentary',           channelId: '' },\n  history:       { query: 'history documentary',           channelId: '' },\n  art:           { query: 'art tutorial',                  channelId: '' },\n  pets:          { query: 'dog training long video',       channelId: '' },\n  nature:        { query: 'nature documentary',            channelId: '' },\n  business:      { query: 'business podcast',              channelId: '' },\n  motivation:    { query: 'motivational speech long',      channelId: '' },\n  lifestyle:     { query: 'lifestyle vlog',                channelId: '' },\n  other:         { query: 'viral stories podcast',         channelId: '' },\n};\n\nconst out = [];\n\nfor (const i of items) {\n  const { clip_class, deficit } = i.json;\n  const cfg = config[clip_class] || config.other;\n\n  // How many new candidates to fetch for this class this run\n  const maxResults = Math.min(Math.max(deficit, 1), 10);\n\n  out.push({\n    json: {\n      clip_class,\n      maxResults,\n      query: cfg.query,\n      channelId: cfg.channelId || null,\n    },\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "51614d3d-64ba-4672-9a64-25303e70391e",
      "name": "Build Search Jobs"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        624,
        -80
      ],
      "id": "a6432827-afc2-4f7a-b1be-89378d822552",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  const clip_class = item.json.clip_class || 'other';\n  const items = item.json.items || [];\n\n  for (const v of items) {\n    const videoId = v.id?.videoId || v.id;\n    if (!videoId) continue;\n    const title = (v.snippet && v.snippet.title) ? v.snippet.title : '';\n    out.push({ json: { videoId, title, clip_class } });\n  }\n}\n\n// Dedupe by videoId (same video can appear in multiple class searches)\nconst seen = new Set();\nreturn out.filter((o) => {\n  if (seen.has(o.json.videoId)) return false;\n  seen.add(o.json.videoId);\n  return true;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        -80
      ],
      "id": "f3d8c78b-10b1-44da-9c0f-69d635e202f2",
      "name": "Normalize Candidates (Code)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT video_id FROM playlist_seen_videos WHERE video_id IN ({{ $json.inList }})",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1248,
        -80
      ],
      "id": "e7ecb380-3f47-4036-9d64-5ae13bc49991",
      "name": "Get Already Seen (Postgres)"
    },
    {
      "parameters": {
        "jsCode": "const videoIds = $input.all().map((i) => i.json.videoId).filter(Boolean);\n\nconst inList = videoIds.length\n  ? videoIds.map((id) => \"'\" + String(id).replace(/'/g, \"''\") + \"'\").join(',')\n  : \"NULL\";  // IN (NULL) returns no rows\n\nreturn [{ json: { videoIds, inList } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        -80
      ],
      "id": "605dabb9-fd5b-4888-b45b-2758da1df1bb",
      "name": "Aggregate and build an IN list"
    },
    {
      "parameters": {
        "jsCode": "// Input 1: Normalize Candidates (all videos). Input 2: Get Already Seen (video_id rows).\nconst candidates = $input.all(0) || [];\nconst seenRows = $input.all(1) || [];\nconst seen = new Set(seenRows.map((r) => r.json?.video_id).filter(Boolean));\n\nreturn candidates.filter((c) => !seen.has(c.json.videoId));"
      },
