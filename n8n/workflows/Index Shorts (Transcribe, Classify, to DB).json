    {
      "parameters": {
        "content": "Indexing only: find MP4 (excl. processed/) → transcribe → classify (content class) → title → insert into Postgres → move file to processed/. Upload is a separate workflow.",
        "height": 320,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1680,
        160
      ],
      "id": "d698a262-c246-4a04-9d0b-6b11926ed938",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "llama3.1:8b",
          "mode": "list",
          "cachedResultName": "llama3.1:8b"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a viral short-form content title generator.\n\nInput: a transcript of a video.\nTask: Create ONE title based only on the transcript’s main hook and most surprising/valuable moment.\n\nRules:\n- Output MUST be ONLY the final title text, nothing before or after.\n- Do NOT explain, do NOT say \"Here is the title\", do NOT include character counts.\n- Max 97 characters (shorter is fine), no need to hit it exactly.\n- Use punchy, curiosity-driven wording. Front-load the hook in the first 6 words.\n- Optimize for TikTok/YouTube Shorts: strong emotion + clear topic + benefit.\n- Include 3–6 relevant hashtags at the end (hashtags count in the 97 chars).\n- No emojis. No quotes. Do not mention “transcript” or “AI”.\n\nTranscript:\n{{ $json.data }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        -288,
        144
      ],
      "id": "9367afee-2ce3-434c-9e13-963aa9ab4e04",
      "name": "Generate Title"
    },
    {
