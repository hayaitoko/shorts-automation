    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  const raw =\n    item.json.youtube_title ??\n    item.json.title ??\n    item.json.content ??\n    '';\n\n  let title = String(raw).replace(/[<>]/g, '').replace(/\\s+/g, ' ').trim();\n  title = title.slice(0, 100).trim();\n\n  if (!title) title = 'Untitled';\n\n  return {\n    json: { ...item.json, youtube_title: title },\n    binary: item.binary, // <-- THIS keeps binary.data\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        144
      ],
      "id": "c73e5d8b-4aa1-437c-98e2-740a7a1b1576",
      "name": "Refine Title Data"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "llama3.1:8b",
          "mode": "list",
          "cachedResultName": "llama3.1:8b"
        },
        "messages": {
          "values": [
            {
              "content": "=You classify short-form video content into exactly one content class and suggest tags.\n\nClasses (pick ONE): cars, tech, music, gaming, fitness, cooking, travel, comedy, education, diy, beauty, fashion, sports, news, entertainment, science, history, art, pets, nature, business, motivation, lifestyle, other.\n\nTranscript:\n{{ $json.data || $json.text || '' }}\n\nRespond with ONLY valid JSON, no markdown or explanation:\n{\"clip_class\": \"<one of the classes above>\", \"tags\": [\"tag1\", \"tag2\", \"...\"], \"confidence\": 0.0-1.0}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        -480,
        352
      ],
      "id": "6d1da740-9ce1-43b9-a977-b8ca8df01f8c",
      "name": "Classify Video"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nlet raw = item.json.message?.content ?? item.json.content ?? item.json.response ?? JSON.stringify(item.json);\nconst jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\nconst parsed = jsonMatch ? JSON.parse(jsonMatch[0]) : {};\nconst clip_class = parsed.clip_class || 'other';\nconst tags = Array.isArray(parsed.tags) ? parsed.tags : [];\nconst confidence = typeof parsed.confidence === 'number' ? parsed.confidence : 0.5;\nreturn [{ json: { clip_class, tags, confidence } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -176,
        352
      ],
      "id": "47b05b64-fffb-44df-94f6-4b6e093f891b",
      "name": "Parse Classify"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst findNode = $('Find Video Files').first();\nconst file_path_original = (findNode?.json?.stdout ?? '').trim();\nif (!file_path_original) return [];\nconst lastSlash = file_path_original.lastIndexOf('/');\nconst dir = lastSlash >= 0 ? file_path_original.slice(0, lastSlash) : file_path_original;\nconst base = file_path_original.slice(lastSlash + 1);\nconst file_path_processed = `/var/lib/n8n/shorts/processed/${base}`;\nconst transcript = item.json.data ?? item.json.text ?? '';\nconst title = item.json.youtube_title ?? item.json.title ?? 'Untitled';\nconst clip_class = item.json.clip_class ?? 'other';\nconst tags = Array.isArray(item.json.tags) ? item.json.tags : [];\nreturn [{\n  json: {\n    file_path: file_path_processed,\n    file_path_original,\n    title,\n    transcript,\n    clip_class,\n    tags,\n    status: 'queued'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        368
      ],
