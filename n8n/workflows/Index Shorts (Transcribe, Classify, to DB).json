      "parameters": {
        "jsCode": "const item = $input.first();\nconst o = item.json.file_path_original;\nconst p = item.json.file_path;\nif (!o || !p) return [];\nconst dir = p.slice(0, p.lastIndexOf('/'));\nitem.json.command = 'mkdir -p \"' + dir + '\" && mv \"' + o + '\" \"' + p + '\"';\nreturn [item];"
      },
